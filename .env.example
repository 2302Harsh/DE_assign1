# Copy this file to .env and fill in your key. Never commit or share .env.
# Free key: https://openchargemap.org/site/develop/api
# Only needed for the first run of 03_data_augmentation.py (or with --refresh);
# later runs use the cached data/raw/ocm_au_pois.json.
OPENCHARGEMAP_API_KEY=your-key-here

# 03_data_augmentation.py's second source, OpenStreetMap (via the Overpass
# API), is free and needs no key or entry here - nothing to configure.
